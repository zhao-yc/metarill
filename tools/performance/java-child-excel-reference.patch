+package com.yinzon.samplehost;
+
+import com.alibaba.fastjson2.JSON;
+import com.baomidou.mybatisplus.core.MybatisConfiguration;
+import com.baomidou.mybatisplus.core.metadata.TableInfoHelper;
+import com.yinzon.controller.admin.interceptor.PowerInterceptor;
+import com.yinzon.entity.SampleContract;
+import com.yinzon.entity.SampleContractLine;
+import com.yinzon.entity.YzManager;
+import com.yinzon.generated.page.SampleContractLine81003ImportSupport;
+import com.yinzon.mapper.SampleContractMapper;
+import com.yinzon.service.SampleContractLineService;
+import com.yinzon.yzp.runtime.dto.TableImportDTO;
+import org.apache.ibatis.builder.MapperBuilderAssistant;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.transaction.annotation.Transactional;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+/** 离线验证对照夹具的字符串父键、身份和整批异常传播。 */
+class PairedChildImportReferenceTests {
+    private static final String PARENT = "9007199254760000";
+    private final SampleContractMapper parents = mock(SampleContractMapper.class);
+    private final SampleContractLineService lines = mock(SampleContractLineService.class);
+    private final SampleContractLine81003ImportSupport importer = new SampleContractLine81003ImportSupport(lines, parents);
+
+    @BeforeAll
+    static void initializeMapperMetadata() {
+        var assistant = new MapperBuilderAssistant(new MybatisConfiguration(), "reference");
+        assistant.setCurrentNamespace(SampleContractMapper.class.getName());
+        assertTrue(TableInfoHelper.initTableInfo(assistant, SampleContract.class).isWithLogicDelete());
+    }
+
+    @Test
+    void bindsRequestParentBeforeOriginalServiceSave() {
+        var actor = new YzManager();
+        actor.setId("17");
+        try (var security = mockStatic(PowerInterceptor.class)) {
+            security.when(PowerInterceptor::getCurrentLoginYzManager).thenReturn(actor);
+            when(parents.selectOne(any())).thenReturn(new SampleContract());
+            when(lines.save(any())).thenReturn(true);
+            assertEquals(200, importer.importDatas81003(request(PARENT)).getCode());
+            var captured = ArgumentCaptor.forClass(SampleContractLine.class);
+            verify(lines, times(2)).save(captured.capture());
+            for (var row : captured.getAllValues()) {
+                assertEquals(PARENT, row.getSampleContractId());
+                assertEquals("17", row.getInsertManagerId());
+                assertEquals("17", row.getUpdateManagerId());
+            }
+            verify(parents).selectOne(argThat(query -> query.getSqlSegment().endsWith("LIMIT 1 FOR UPDATE")));
+        }
+    }
+
+    @Test
+    void invalidOrMissingParentDoesNotWrite() {
+        for (String id : new String[]{null, "0", "01", "-2", "9223372036854775808"}) {
+            assertThrows(IllegalArgumentException.class, () -> importer.importDatas81003(request(id)));
+        }
+        verifyNoInteractions(parents, lines);
+        assertThrows(IllegalArgumentException.class, () -> importer.importDatas81003(request(PARENT)));
+        verifyNoInteractions(lines);
+    }
+
+    @Test
+    void failedSecondSaveEscapesTransactionBoundary() throws NoSuchMethodException {
+        var tx = importer.getClass().getMethod("importDatas81003", TableImportDTO.class).getAnnotation(Transactional.class);
+        assertArrayEquals(new Class<?>[]{Exception.class}, tx.rollbackFor());
+        var actor = new YzManager();
+        actor.setId("17");
+        try (var security = mockStatic(PowerInterceptor.class)) {
+            security.when(PowerInterceptor::getCurrentLoginYzManager).thenReturn(actor);
+            when(parents.selectOne(any())).thenReturn(new SampleContract());
+            when(lines.save(any())).thenReturn(true, false);
+            assertThrows(IllegalStateException.class, () -> importer.importDatas81003(request(PARENT)));
+            verify(lines, times(2)).save(any());
+        }
+    }
+
+    private static TableImportDTO request(String parent) {
+        var request = new TableImportDTO();
+        request.setParentId(parent);
+        request.setRequestJson(JSON.parseArray("[{\"明细名称\":\"甲\",\"明细金额\":0.50},{\"明细名称\":\"乙\",\"明细金额\":1.50}]"));
+        return request;
+    }
+}
